{
  "name": "fitness-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "增肌记录 — 单用户健身记录服务前端 (Vue 3 + Vite + TS + Pinia + Element Plus + ECharts)",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "gen:legacy-vectors": "node scripts/gen-legacy-vectors.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "axios": "1.18.1",
    "echarts": "5.6.0",
    "element-plus": "2.14.2",
    "pinia": "2.3.1",
    "vue": "3.5.39",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.11",
    "jsdom": "29.1.1",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "4.1.9",
    "vue-tsc": "2.2.12"
  }
}
